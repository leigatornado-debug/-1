<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="虚拟定位测试工具"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="配速单位：分:秒 / 公里。仅用于设备和应用测试。" />

        <EditText
            android:id="@+id/paceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="配速，例如 6:00 min/km"
            android:inputType="text"
            android:text="6:00" />

        <EditText
            android:id="@+id/latitudeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="起始纬度"
            android:inputType="numberDecimal|numberSigned"
            android:text="39.909" />

        <EditText
            android:id="@+id/longitudeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="起始经度"
            android:inputType="numberDecimal|numberSigned"
            android:text="116.397" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启动测试定位" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示/隐藏摇杆悬浮窗" />

        <Button
            android:id="@+id/sampleRouteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="填入示例路线" />

        <EditText
            android:id="@+id/routeInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="路线点：纬度,经度;纬度,经度"
            android:inputType="textMultiLine"
            android:text="39.9090,116.3970;39.9095,116.3980;39.9100,116.3990" />

        <Button
            android:id="@+id/routeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放路线" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止并关闭悬浮窗" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="状态：未启动" />
    </LinearLayout>
</ScrollView>
